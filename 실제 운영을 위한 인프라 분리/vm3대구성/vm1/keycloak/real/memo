# Infinispan 클러스터링 및 JGroups 통신 설정을 위해 8080,7800 포트 개발 필요

# TCP 7800 및 UDP 7800 포트 영구 개방
sudo firewall-cmd --permanent --add-port=8080/tcp

# 방화벽 설정 적용 갱신
sudo firewall-cmd --reload

# keycloak 기동 시 Infinispan 클러스터링의 ip가 실제 ip인지 확인 필요
# Infinispan 클러스터링이 구성되면, L4 VIP로 동일한 아이디로 로그인 시 하나로 관리됨. 3대 각각의 ip로 접근할때는 각각 세션이 독립적이므로 주의
