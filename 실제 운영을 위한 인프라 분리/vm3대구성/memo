== postgresql-client 패키지 설치 ==
#Alpine Linux 기반 컨테이너 내부인 경우 (가장 유력)
apk update && apk add --no-cache postgresql-client
#Ubuntu / Debian 계열 호스트 OS인 경우
sudo apt update && sudo apt install -y postgresql-client
#RHEL / Rocky Linux / CentOS 계열 호스트 OS인 경우
sudo dnf install -y postgresql
#Apple PostgreSQL 클라이언트 라이브러리(libpq)를 설치
brew install libpq
echo 'export PATH="/opt/homebrew/opt/libpq/bin:$PATH"' >> ~/.zshrc
source ~/.zshrc

== PostgreSQL 직접 접속을 통한 복제 검증 ==
psql -h localhost -p 5432 -U postgres -d postgres

psql -h localhost -p 5433 -U postgres -d postgres
psql -h localhost -p 5434 -U postgres -d postgres
psql -h localhost -p 5435 -U postgres -d postgres
(패스워드: enterprise_secure_password 입력)

복제 상태(Replication Status) 쿼리 실행:

SQL
SELECT client_addr, state, sync_state FROM pg_stat_replication;
정상 결과: 스탠바이(Replica) 노드들이 streaming 상태로 접속해 있는 행(Row)들이 출력됩니다.

== 고가용성 postgreSQL 사용법 ==
postgresql://[사용자명]:[비밀번호]@192.168.0.130:5431,192.168.0.130:5432,192.168.0.130:5433/[데이터베이스명]?target_session_attrs=read-write
postgresql://keycloak:keycloak_password@192.168.0.130:5433,192.168.0.130:5434,192.168.0.130:5435/keycloak?target_session_attrs=read-write
postgresql://keycloak:keycloak_password@192.168.0.130:5433,192.168.0.130:5434,192.168.0.130:5435/keycloak?target_session_attrs=read-only

== postgreSQL 계정 생성 ==
CREATE ROLE keycloak WITH LOGIN PASSWORD 'keycloak_password';

== 데이터베이스 생성 및 소유권 이전 ==
CREATE DATABASE keycloak OWNER keycloak;

== 스키마 생성 및 소유권 부여 ==
-- 1. keycloak 스키마 생성
CREATE SCHEMA keycloak AUTHORIZATION keycloak;

-- 2. 해당 스키마에 대한 모든 권한을 keycloak 계정에 부여
GRANT ALL PRIVILEGES ON SCHEMA keycloak TO keycloak;

== DBA 수준의 전체 권한 부여 (해당 DB 내에서) ==
-- 1. 해당 DB에 대한 모든 권한 부여
GRANT ALL PRIVILEGES ON DATABASE keycloak TO keycloak;

-- 2. (중요) 향후 새로 만들어지는 테이블들에 대해서도 자동으로 권한이 부여되도록 설정
ALTER DEFAULT PRIVILEGES IN SCHEMA keycloak GRANT ALL ON TABLES TO keycloak;
ALTER DEFAULT PRIVILEGES IN SCHEMA keycloak GRANT ALL ON SEQUENCES TO keycloak;
ALTER DEFAULT PRIVILEGES IN SCHEMA keycloak GRANT ALL ON FUNCTIONS TO keycloak;

-- 3. 만약 완전한 인스턴스/DB 레벨의 슈퍼유저 급 권한이 필요하다면 (선택)
ALTER ROLE keycloak CREATEDB;

== postgreSQL의 데이터베이스(Database) 목록 확인 ==
SELECT 
    datname AS database_name,
    pg_catalog.pg_get_userbyid(datdba) AS owner,
    pg_encoding_to_char(encoding) AS encoding
FROM pg_database
WHERE datistemplate = false -- 템플릿 DB 제외
ORDER BY datname;

== 스키마(Schema) 목록 확인 ==
SELECT 
    schema_name,
    schema_owner
FROM information_schema.schemata
WHERE schema_name NOT LIKE 'pg_%' 
  AND schema_name != 'information_schema'
ORDER BY schema_name;

== 계정(Role) 목록 조회 SQL ==
SELECT 
    rolname AS role_name,
    rolsuper AS is_superuser,
    rolcreatedb AS can_create_db,
    rolcreaterole AS can_create_role,
    rolcanlogin AS can_login,
    rolconnlimit AS connection_limit
FROM pg_roles
ORDER BY rolname;
